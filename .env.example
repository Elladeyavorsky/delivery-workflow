# Copia este fichero como `.env` en la raíz de tu proyecto y rellena lo que uses.
# `.env` va en `.gitignore`: no lo subas al repositorio.

# GitHub: token clásico con el permiso `repo`.
GITHUB_TOKEN=

# GitLab: token con el permiso `api`.
# GITLAB_TOKEN=

# Instancia propia de GitLab. La dirección solo hace falta si la web no está en el host de `origin`.
# GIT_WORKFLOW_FORGE=gitlab
# GIT_WORKFLOW_FORGE_URL=https://gitlab.example.com

# Opcional. Clave de Context7, para tener más peticiones.
# CONTEXT7_API_KEY=

# Opcional. Token del bot para activar los avisos de Discord.
# DISCORD_BOT_TOKEN=
