# Entorno de desarrollo de <proyecto>: las mismas versiones para todo el equipo.
# Lo usan docker-compose.yml y .devcontainer/devcontainer.json.
# Cambia cada <…> por el valor real del proyecto y comprueba cada versión en su fuente.
FROM <imagen>:<versión exacta> AS base

ARG <HERRAMIENTA>_VERSION=<versión>
# Huellas de <herramienta>-linux-*.tar.gz en su release. Cambian con <HERRAMIENTA>_VERSION.
ARG <HERRAMIENTA>_SHA256_ARM64=<sha256>
ARG <HERRAMIENTA>_SHA256_X86_64=<sha256>
# Lo pone Docker al construir: arm64 o amd64.
ARG TARGETARCH

RUN case "$TARGETARCH" in \
    arm64) arch=arm64; sha256=$<HERRAMIENTA>_SHA256_ARM64 ;; \
    amd64) arch=x86_64; sha256=$<HERRAMIENTA>_SHA256_X86_64 ;; \
    *) echo "Arquitectura sin binario: $TARGETARCH" >&2; exit 1 ;; \
  esac \
  && curl -fsSL -o /tmp/tool.tar.gz "<url de la release>/<herramienta>-linux-${arch}.tar.gz" \
  && echo "${sha256}  /tmp/tool.tar.gz" | sha256sum -c - \
  && mkdir -p /opt/<herramienta> \
  && tar -xzf /tmp/tool.tar.gz -C /opt/<herramienta> --strip-components=1 \
  && rm /tmp/tool.tar.gz \
  && ln -s /opt/<herramienta>/<herramienta> /usr/local/bin/<herramienta>

# El repositorio llega montado: git no tiene que quejarse del dueño.
RUN git config --system --add safe.directory '*'

# Las dependencias de Linux viven en volúmenes, nunca en la carpeta del proyecto.
RUN mkdir -p /work/<app>/node_modules \
  && chown -R <usuario>:<usuario> /work

USER <usuario>
ENV CI=true
WORKDIR /work

# Opcional: paquetes del sistema para un servicio aparte. Solo si hacen falta.
FROM base AS <etapa opcional>
ARG DEBIAN_SNAPSHOT=<AAAAMMDD>T000000Z
USER root
RUN apt-get update --snapshot "$DEBIAN_SNAPSHOT" \
  && apt-get install -y --no-install-recommends --snapshot "$DEBIAN_SNAPSHOT" \
    <paquete>=<versión> \
  && rm -rf /var/lib/apt/lists/*
USER <usuario>
